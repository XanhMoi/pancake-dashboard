# ─────────────────────────────────────────────────────────────
# Cấu hình pancake-dashboard chạy trên VPS
# Trên VPS: chép thành .env thật rồi điền secret (KHÔNG commit .env):
#     cp deploy/env.example .env && nano .env
# systemd nạp file này qua EnvironmentFile.
# ─────────────────────────────────────────────────────────────

# Cổng app chạy nội bộ — Caddy sẽ proxy vào cổng này (giữ 3000)
PORT=3000

# Thư mục lưu data BỀN (users.json / config.json / logins.json).
# Phải trỏ tới thư mục ổn định trên VPS — đừng để mất khi update code.
DATA_DIR=/opt/pancake-dashboard/data

# ─── SECRET — điền giá trị thật, đừng để nguyên placeholder ───

# Meta System User token (CHÍNH token đang chạy fb-dashboard).
# Lấy: mở fb-dashboard/.env trên máy anh, copy dòng FB_ACCESS_TOKEN.
# Dùng cho Kênh Live + Chi ads Live Đại/Mess. Thiếu → mấy thẻ ads ẩn.
FB_ACCESS_TOKEN=

# api_key POS Pancake vĩnh viễn (chuỗi 32 ký tự anh đang dùng).
# HOẶC để trống ở đây rồi dán trong ⚙️ Cấu hình sau khi vào dashboard.
PANCAKE_API_KEY=

# Admin đầu tiên — chỉ dùng LẦN CHẠY ĐẦU để tạo tài khoản admin.
ADMIN_USER=admin
ADMIN_PASS=DOI_MAT_KHAU_MANH_O_DAY

# Chuỗi ký cookie phiên — BẮT BUỘC đổi thành chuỗi ngẫu nhiên dài.
# Tạo nhanh trên VPS:  openssl rand -hex 32
SESSION_SECRET=DOI_THANH_CHUOI_NGAU_NHIEN_DAI
